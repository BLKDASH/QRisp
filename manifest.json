{
  "manifest_version": 3,
  "name": "QRisp",
  "version": "1.1.0",
  "description": "将当前网址、网页选中文字或自定义内容离线生成二维码，支持复制和下载。",
  "permissions": ["activeTab", "clipboardWrite", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "incognito": "split",
  "action": {
    "default_title": "QRisp",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
